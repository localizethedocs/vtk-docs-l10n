msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/numpy_interface/vtk_partitioned_array.py:1119
msgid ""
"The division operator does not know how to map a scalar to a vector due to a "
"mismatch in dimensions. This can be solved by making the scalar a vector of "
"1 component (increasing its dimension to 2) as follows:"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/numpy_interface/vtk_partitioned_array.py:1123
msgid ""
"v / np.expand_dims(algs.mag(v), 1) VTKArray([[ 0.57735027,  0.57735027,  "
"0.57735027],        [ 0.57735027,  0.57735027,  0.57735027],        "
"[ 0.57735027,  0.57735027,  0.57735027],        [ 0.57735027,  0.57735027,  "
"0.57735027],        [ 0.57735027,  0.57735027,  0.57735027]])"
msgstr ""

