"list of lists, or ``vtkDataArray``::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/data_model.py:870
msgid ""
"pts = vtkPoints(data=np.array([[0,0,0], [1,0,0]]))\n"
"pts = vtkPoints(data=[[0,0,0], [1,0,0]])\n"
"pts = vtkPoints(data=vtk_data_array)\n"
msgstr ""
