#: ../../../release_details/9.7/anari-materials-library-support.md:1
msgid "ANARI material library support"
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:3
msgid ""
"VTK now offers material library support for ANARI rendering through a shared "
"`vtkRenderMaterialLibrary` base class in RenderingCore. This replaces "
"renderer-specific implementations with a unified framework that works across "
"ANARI, OSPRay, and future backends. The two backends currently implemented "
"are `vtkOSPRayMaterialLibrary` and `vtkANARIMaterialLibrary`."
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:9
msgid ""
"Texture I/O is now handled with a common `ReadTextureFileOrData` interface, "
"to allow each backend to do its parameter validation and serialization."
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:12
msgid ""
"The ANARI implementation includes case-insensitive parameter lookups and a "
"`MATERIAL_NAMES` macro for runtime introspection, making it easier to work "
"with materials programmatically."
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:16
msgid "Here's how you define materials for ANARI in a material file:"
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:18
msgid ""
"newmtl glossy_red\n"
"ka 0.1 0.1 0.1\n"
"kd 0.8 0.0 0.0\n"
"ks 0.9 0.9 0.9\n"
"ns 128.0\n"
"map_kd red_texture.png\n"
"\n"
"newmtl matte_blue\n"
"ka 0.05 0.05 0.05\n"
"kd 0.0 0.0 0.8\n"
"ks 0.1 0.1 0.1\n"
"ns 8.0\n"
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:33
msgid "Then load and use the material library with the ANARI renderer:"
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:35
msgid ""
"from vtkmodules.vtkRenderingAnari import vtkANARIMaterialLibrary, "
"vtkAnariPass, vtkAnariSceneGraph\n"
"from vtkmodules.vtkRenderingCore import vtkRenderer\n"
"\n"
"material_lib = vtkANARIMaterialLibrary()\n"
"material_lib.ImportMaterials(\"materials.mtl\")\n"
"\n"
"vtkAnariSceneGraph.SetMaterialLibrary(material_lib, renderer)\n"
"\n"
"renderer = vtkRenderer()\n"
"anari_pass = vtkAnariPass()\n"
"renderer.SetPass(anari_pass)\n"
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:49
msgid "Or in C++:"
msgstr ""

#: ../../../release_details/9.7/anari-materials-library-support.md:51
msgid ""
"auto material_lib = vtkNew<vtkANARIMaterialLibrary>();\n"
"material_lib->ImportMaterials(\"materials.mtl\");\n"
"\n"
"vtkAnariSceneGraph::SetMaterialLibrary(material_lib, renderer);\n"
"\n"
"auto renderer = vtkNew<vtkRenderer>();\n"
"auto anari_pass = vtkNew<vtkAnariPass>();\n"
"renderer->SetPass(anari_pass);\n"
msgstr ""
