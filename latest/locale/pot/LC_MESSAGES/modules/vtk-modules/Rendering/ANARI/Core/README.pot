#: ../../../modules/vtk-modules/Rendering/ANARI/Core/README.md:43
msgid "Example"
msgstr ""

#: ../../../modules/vtk-modules/Rendering/ANARI/Core/README.md:45
msgid ""
"The following code snippet is an example showing how to render an image "
"using only ANARI offscreen and saving it to disk:"
msgstr ""

#: ../../../modules/vtk-modules/Rendering/ANARI/Core/README.md:47
msgid ""
"// To test with helide, available in the ANARI SDK:\n"
"// export ANARI_LIBRARY=helide\n"
"\n"
"// Classic VTK rendering pipeline\n"
"vtkNew<vtkSphereSource> source;\n"
"\n"
"vtkNew<vtkPolyDataMapper> mapper;\n"
"mapper->SetInputConnection(source->GetOutputPort());\n"
"\n"
"vtkNew<vtkActor> actor;\n"
"actor->SetMapper(mapper);\n"
"\n"
"vtkNew<vtkRenderer> renderer;\n"
"renderer->AddActor(actor);\n"
"\n"
"// We use directly the 'vtkAnariRenderWindow' for simplicity.\n"
"// User can rely on the render window factory by using\n"
"// vtkNew<vtkRenderWindow> and set at runtime the environment variable like "
"this:\n"
"// VTK_FACTORY_PREFER=SupportRenderPass=false\n"
"vtkNew<vtkAnariRenderWindow> renderWindow;\n"
"renderWindow->AddRenderer(renderer);\n"
"renderWindow->Render();\n"
"\n"
"// Write the result on disk\n"
"vtkNew<vtkWindowToImageFilter> windowToImage;\n"
"windowToImage->SetInput(renderWindow);\n"
"windowToImage->Update();\n"
"\n"
"vtkNew<vtkPNGWriter> writer;\n"
"std::string outputFileName = \"AnariSphere.png\";\n"
"writer->SetFileName(outputFileName.c_str());\n"
"writer->SetInputConnection(windowToImage->GetOutputPort());\n"
"writer->Write();\n"
msgstr ""

