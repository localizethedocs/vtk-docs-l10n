#: ../../../../../Wrapping/Python/vtkmodules/util/molecule.py:387
msgid ""
"sanitize : bool     If True, run ``Chem.SanitizeMol`` on the result. The "
"returned     mol is otherwise unsanitized: perception of rings, valence, "
"and     aromaticity has not been run, and some downstream RDKit     "
"operations require a sanitized mol. Sanitization is off by     default "
"because molecules derived from geometry or bond     perceivers need not "
"satisfy RDKit's valence model, and     ``SanitizeMol`` would raise on them."
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/molecule.py:388
msgid "Populate this molecule from an RDKit Mol object."
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/molecule.py:390
msgid ""
