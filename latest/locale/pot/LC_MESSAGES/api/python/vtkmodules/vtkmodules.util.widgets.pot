#: ../../../../../Wrapping/Python/vtkmodules/util/widgets.py:9
msgid ""
"Reduces boilerplate by auto-creating representations, forwarding attribute "
"access to the representation, and providing decorator-style event callbacks::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/widgets.py:12
msgid ""
"from vtkmodules.vtkInteractionWidgets import vtkImplicitPlaneWidget2\n"
"\n"
"widget = vtkImplicitPlaneWidget2(iren, bounds=actor.GetBounds(), normal=(0, "
"0, 1))\n"
"\n"
"@widget.on_interaction\n"
"def update():\n"
"    widget.GetPlane(plane)\n"
"\n"
"widget.on()\n"
msgstr ""

