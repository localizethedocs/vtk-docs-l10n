#: ../../../../../Wrapping/Python/vtkmodules/numpy_interface/dataset_adapter.py:52
#: ../../../../../Wrapping/Python/vtkmodules/numpy_interface/dataset_adapter.py:682
msgid ""
"This is a python friendly wrapper of vtkDataSetAttributes. It returns "
"VTKArrays. It also provides the dictionary interface. Note that the stored "
"array should have a shape that matches the number of elements. E.g. for a "
"PointData, narray.shape[0] should be equal to dataset.GetNumberOfPoints()"
msgstr ""

#: ../../../api/python/vtkmodules/vtkmodules.numpy_interface.dataset_adapter.md:54
