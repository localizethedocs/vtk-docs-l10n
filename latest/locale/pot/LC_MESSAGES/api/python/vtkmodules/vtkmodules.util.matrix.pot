#: ../../../../../Wrapping/Python/vtkmodules/util/matrix.py:7
msgid "Pythonic interface for vtkMatrix3x3 and vtkMatrix4x4."
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/matrix.py:9
msgid "Adds natural indexing, arithmetic, and comparison operators::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/matrix.py:11
msgid ""
"m = vtkMatrix4x4([[1,0,0,1],[0,1,0,2],[0,0,1,3],[0,0,0,1]])\n"
"m[0, 3]            # 1.0\n"
"m[0, 3] = 5.0      # SetElement(0, 3, 5.0)\n"
"m[1]               # array([1., 0., 0., 0.]) — row as numpy array\n"
"m[1] = [0,0,0,0]   # set entire row\n"
"m[1:3]             # 2x4 numpy array (row slice)\n"
"m[0, 1:3]          # array([0., 0.]) (column slice of a row)\n"
"m[1:3, 2]          # array([0., 0.]) (row slice of a column)\n"
"m[1:3, 1:3]        # 2x2 numpy submatrix\n"
"len(m)             # 4\n"
"result = m @ other  # matrix multiply\n"
"inv = ~m            # invert\n"
msgstr ""

