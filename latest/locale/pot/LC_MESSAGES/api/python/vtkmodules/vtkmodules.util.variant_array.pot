msgid "Pythonic interface for vtkVariantArray."
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/variant_array.py:9
msgid ""
"Makes vtkVariantArray behave like a Python list of heterogeneous values::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/variant_array.py:11
msgid ""
"arr = vtkVariantArray()\n"
"arr.append(42)\n"
"arr.append(\"hello\")\n"
"arr.append(3.14)\n"
"len(arr)                      # 3\n"
"arr[0]                        # 42\n"
"arr[-1]                       # 3.14\n"
"arr[1] = \"world\"              # SetValue\n"
"\"world\" in arr                # True\n"
"list(arr)                     # [42, 'world', 3.14]\n"
"repr(arr)                     # vtkVariantArray([42, 'world', 3.14])\n"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/variant_array.py:23
msgid ""
"Values are automatically extracted from vtkVariant to native Python types "
"using vtkVariantExtract."
msgstr ""

