#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:653
msgid "Add a representation for *input* to the view and return it."
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:655
msgid ""
"*input* is a ``vtkAlgorithm`` (its output port is connected) or a "
"``vtkDataObject``.  Keyword arguments are applied as properties on the "
"created representation::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:659
msgid ""
"view.show(sphere, color=\"tomato\", opacity=0.8,\n"
"          representation=\"surfacewithedges\")\n"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:662
msgid ""
"*representation_type* selects what to build: a name "
"from :data:`REPRESENTATION_TYPES`, a representation class, or ``None`` for a "
"surface representation::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:666
msgid ""
"view.show(wavelet, \"volume\", scalar_opacity_unit_distance=0.8)\n"
"view.show(wavelet, MyRepresentation)\n"
msgstr ""

