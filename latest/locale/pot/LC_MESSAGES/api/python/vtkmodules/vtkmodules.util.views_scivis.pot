#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:491
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:581
msgid ""
"A dict value configures the sub-object of that name, so the grouping the C++ "
"API has is available at construction too::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:158
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:205
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:418
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:460
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:494
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:584
msgid ""
"view = vtkScivisView(\n"
"    window_title=\"demo\",\n"
"    selector={\"mode\": \"frustum\"},\n"
"    light_kit={\"key_light_intensity\": 0.8},\n"
")\n"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:164
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:211
#: ../../../../../Wrapping/Python/vtkmodules/util/views_scivis.py:424
