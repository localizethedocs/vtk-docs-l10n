#: ../../../../../Wrapping/Python/vtkmodules/util/string_array.py:9
msgid "Makes vtkStringArray behave like a Python list of strings::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/string_array.py:11
msgid ""
"arr = vtkStringArray()\n"
"arr.append(\"hello\")           # InsertNextValue\n"
"arr.extend([\"a\", \"b\", \"c\"])   # InsertNextValue loop\n"
"len(arr)                      # 4\n"
"arr[0]                        # \"hello\"\n"
"arr[-1]                       # \"c\"\n"
"arr[1] = \"world\"              # SetValue\n"
"\"hello\" in arr                # True\n"
"list(arr)                     # [\"hello\", \"world\", \"b\", \"c\"]\n"
"repr(arr)                     # vtkStringArray(['hello', 'world', 'b', "
"'c'])\n"
msgstr ""

