#: ../../../../../Wrapping/Python/vtkmodules/util/information.py:7
msgid "Pythonic interfaces for vtkInformation and vtkInformationVector."
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/information.py:9
msgid "Makes vtkInformation behave like a Python dictionary (key -> value)::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/information.py:11
msgid ""
"from vtkmodules.vtkCommonDataModel import vtkDataObject\n"
"info = vtkInformation()\n"
"info[vtkDataObject.FIELD_NAME()] = \"Pressure\"\n"
"info[vtkDataObject.FIELD_NAME()]           # \"Pressure\"\n"
"vtkDataObject.FIELD_NAME() in info         # True\n"
"del info[vtkDataObject.FIELD_NAME()]       # Remove entry\n"
"len(info)                                  # entry count\n"
"for key in info: ...                       # iterate vtkInformationKey "
"objects\n"
"info.keys()                                # list of vtkInformationKey "
"objects\n"
"info.string_keys()                         # list of key name strings\n"
"info.values(), info.items()                # dict-like views\n"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/information.py:23
msgid "Makes vtkInformationVector behave like a Python list::"
msgstr ""

#: ../../../../../Wrapping/Python/vtkmodules/util/information.py:25
msgid ""
"vec = vtkInformationVector()\n"
"vec.append(vtkInformation())\n"
"len(vec)          # 1\n"
"vec[0]            # vtkInformation\n"
"for info in vec:  # iterate\n"
msgstr ""

