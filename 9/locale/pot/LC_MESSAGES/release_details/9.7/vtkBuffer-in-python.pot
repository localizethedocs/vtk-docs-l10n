#: ../../../release_details/9.7/vtkBuffer-in-python.md:80
msgid "Accessing Buffers from Data Arrays"
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:82
msgid ""
"You can now access the underlying `vtkBuffer` objects from VTK data arrays, "
"enabling direct buffer protocol access to array memory:"
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:85
msgid ""
"import numpy as np\n"
"from vtkmodules.vtkCommonCore import vtkFloatArray\n"
"\n"
"# Create a VTK array\n"
"arr = vtkFloatArray()\n"
"arr.SetNumberOfComponents(3)\n"
"arr.SetNumberOfTuples(100)\n"
"\n"
"# Get the underlying buffer (for AOS arrays)\n"
"buf = arr.GetBuffer()\n"
"\n"
"# Create a numpy view of the raw buffer\n"
"raw_data = np.asarray(buf)\n"
"print(raw_data.shape)  # (300,) - flattened view of 100 tuples x 3 "
"components\n"
msgstr ""

