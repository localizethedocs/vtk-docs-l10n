#: ../../../release_details/9.7/vtkBuffer-in-python.md:1
msgid "vtkBuffer Python Integration and NumPy Memory Safety"
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:3
msgid "Overview"
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:5
msgid ""
"VTK now provides improved Python/NumPy interoperability through the "
"`vtkBuffer` class with full buffer protocol support. This enables zero-copy "
"data sharing between VTK arrays and NumPy, along with improved memory safety "
"when VTK arrays reallocate."
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:9
msgid "vtkBuffer and the Python Buffer Protocol"
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:11
msgid "Direct Buffer Access"
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:13
msgid ""
"You can now use `vtkBuffer` directly from Python with seamless NumPy "
"integration. The buffer protocol implementation enables zero-copy views of "
"VTK memory:"
msgstr ""

#: ../../../release_details/9.7/vtkBuffer-in-python.md:16
msgid ""
"import numpy as np\n"
"from vtkmodules.vtkCommonCore import vtkBuffer\n"
"\n"
"# Create a typed buffer\n"
"buf = vtkBuffer['float64']()\n"
"buf.Allocate(100)\n"
"\n"
"# Create a numpy array that shares memory with the buffer (zero-copy)\n"
"arr = np.asarray(buf)\n"
"\n"
"# Modifications through numpy are reflected in the VTK buffer\n"
"arr[:] = np.linspace(0, 1, 100)\n"
"\n"
"# Multiple numpy arrays can share the same buffer\n"
"arr2 = np.asarray(buf)\n"
"assert np.shares_memory(arr, arr2)\n"
msgstr ""

